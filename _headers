# Intent Gate Embed - Cloudflare Pages cache rules + CORS
# loader and manifest must revalidate every time; versioned embed is immutable
# CORS: allow any origin so company pages (e.g. applyintent-demo.pages.dev) can fetch manifest and load embed

/loader.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Access-Control-Allow-Origin: *

/manifest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Access-Control-Allow-Origin: *

/embed.*.js
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/embed.*.js
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
