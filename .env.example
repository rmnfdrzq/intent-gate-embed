# API server base URL (used for /v1/gates/resolve, token issue/verify)
API_BASE=http://localhost:3000

# Gate UI base URL and origin (gate form opens in new tab)
GATE_UI_BASE=http://localhost:5173
GATE_UI_ORIGIN=http://localhost:5173

# Timeouts (ms)
HANDSHAKE_TIMEOUT_MS=5000
MUTATION_OBSERVER_TIMEOUT_MS=8000

# Form discovery
DEBOUNCE_MS=250
SCORE_THRESHOLD=5
SCORE_GAP_REQUIRED=2

# Debug mode (form scoring logs)
DEBUG=false
